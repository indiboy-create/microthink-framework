{
    "name": "youvision/microthink-framework",
    "description": "A minimal PHP framework inspired by ThinkPHP8, powered by SQLite and MySQL.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "league/glide": "^4.2"
    },
    "suggest": {
        "ext-pdo_sqlite": "SQLite 驱动支持",
        "ext-pdo_mysql": "MySQL 驱动支持",
        "ext-gd": "GD 图形库，缩略图生成的默认驱动",
        "ext-imagick": "Imagick 图形库，缩略图生成的替代驱动"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "mini\\": "src/",
            "app\\": "app/"
        },
        "files": [
            "app/common.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "mini\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-create-project-cmd": [
            "@php -r \"is_dir('public/uploads') || mkdir('public/uploads', 0775, true);\"",
            "@php -r \"echo PHP_EOL . 'microthink-framework ready. Visit /install to complete setup.' . PHP_EOL . PHP_EOL;\""
        ]
    }
}
